{extends '../Layout/Base.latte'}
{parameters
    DlangAT\StatusPage\Model\Check[] $checksAlert,
    DlangAT\StatusPage\Model\Check[] $checksUp,
    DlangAT\StatusPage\Model\Dashboard $dashboard,
}
{var $navGroup = 'dashboard'}
{var $title = 'Dashboard: ' . $dashboard->title}
{var int $alertCount = count($checksAlert)}

{block main}
    {if ($dashboard !== null) && !empty($dashboard->description)}
        <div class="text-center bg-body-tertiary border rounded-3 mb-4 p-4">
            {$dashboard->description | noescape}
        </div>
    {/if}

    {embed '../Components/DashboardEntries.latte', checksAlert: $checksAlert, checksUp: $checksUp}
    {/embed}

    {if !$dashboard->hideSummary}
        {if $alertCount > 0}
            <div class="alert alert-danger">
                {$alertCount}
            {if $alertCount === 1}
                    service is
                {else}
                    services are
                {/if}
                impacted.
            </div>
        {else}
            <div class="alert alert-success">
                All services are up.
            </div>
        {/if}
    {/if}
{/block}
